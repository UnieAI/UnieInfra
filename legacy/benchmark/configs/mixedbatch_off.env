# E31 control arm: mixed prefill+decode batching OFF (the shipped default).
# Paired back-to-back with configs/mixedbatch_on.env on the SAME box/GPU.
# Only difference between the two files is --enable-mixed-batch.
MODEL=/workspace/models/Qwen/Qwen3-8B
GPU=3
PORT=8030
ATTN=triton
# E17: the 139GB host-KVStore allocation OOM-kills the server on this box.
EXTRA_ARGS="--disable-kvstore"
PROFILE=0
BASELINE=clean
