 src/turbomind/kernels/core/mma.h              |   5 +
 src/turbomind/kernels/gemm/CMakeLists.txt     |   9 +
 .../kernels/gemm/arch/config_sm80_s16816.h    |   9 +-
 src/turbomind/kernels/gemm/iterator_sm80.h    |   6 +-
 .../kernels/gemm/kernel/sm120_16816_4.cu      | 225 ++++++++++++++++++
 src/turbomind/kernels/gemm/registry.cu        |   6 +
 src/turbomind/kernels/gemm/registry.h         |   4 +
 8 files changed, 277 insertions(+), 4 deletions(-)
 create mode 100644 src/turbomind/kernels/gemm/kernel/sm120_16816_4.cu

diff --git a/src/turbomind/kernels/core/common.h b/src/turbomind/kernels/core/common.h
index 398f0ed4..7b2af7ba 100644
--- a/src/turbomind/kernels/core/common.h
+++ b/src/turbomind/kernels/core/common.h
@@ -30,6 +30,23 @@
 
 #define TURBOMIND_ARCH_HAS_FP8 TURBOMIND_ARCH_SM90
 
+// L2 evict-first cache policy on `cp.async` (createpolicy + .L2::cache_hint).
+//
+// On sm_12x this faults with an illegal instruction when the hint is applied to
+// the packed-B (quantized weight) operand.  Measured on an RTX PRO 6000
+// Blackwell, holding the tile fixed and varying only the policy: `Stream` on A
+// runs, `Stream` on B faults, on every tile tried.  The emitted `LDGSTS` forms
+// are identical either way -- the difference is in the memory descriptor the
+// hint builds, not in the opcode -- and the same PTX in isolation runs fine, so
+// this is narrower than "sm_120 lacks L2 policies".
+//
+// The policy is a pure performance hint, so dropping it cannot change results.
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 1200) && (__CUDA_ARCH__ < 1300)
+#define TURBOMIND_ARCH_HAS_L2_EVICT_POLICY 0
+#else
+#define TURBOMIND_ARCH_HAS_L2_EVICT_POLICY TURBOMIND_ARCH_SM80
+#endif
+
 #define TURBOMIND_ARCH_BF16_GUARD(type) (TURBOMIND_ARCH_HAS_BF16 || type != ::turbomind::kBfloat16)
 
 #define TURBOMIND_ARCH_FP8_GUARD(type)                                                                                 \
diff --git a/src/turbomind/kernels/core/mma.h b/src/turbomind/kernels/core/mma.h
index 768cdcbe..fab08dec 100644
--- a/src/turbomind/kernels/core/mma.h
+++ b/src/turbomind/kernels/core/mma.h
@@ -5,6 +5,11 @@
 #include "src/turbomind/kernels/core/array.h"
 #include "src/turbomind/kernels/core/common.h"
 #include <cassert>
+// `nv_bfloat16` is used by the m16n8k16/m16n8k8 bf16 overloads below.  Up to
+// CUDA 12.x it arrived transitively; CUDA 13's `cuda_runtime.h` no longer pulls
+// it in, so every kernel TU that includes this header first (sm70/75/80/120)
+// fails with "identifier nv_bfloat16 is undefined".
+#include <cuda_bf16.h>
 
 namespace turbomind {
 
diff --git a/src/turbomind/kernels/gemm/CMakeLists.txt b/src/turbomind/kernels/gemm/CMakeLists.txt
index 7a1b2107..b0b65bf5 100644
--- a/src/turbomind/kernels/gemm/CMakeLists.txt
+++ b/src/turbomind/kernels/gemm/CMakeLists.txt
@@ -15,6 +15,14 @@ set(GEMM2_KERNELS_SM80
     kernel/sm80_16816_8.cu
     kernel/sm80_16816_16.cu
 )
+# mma.m16n8k16 kernels re-tagged for sm_120; they use no instruction sm_120
+# lacks, so they build under whatever `CMAKE_CUDA_ARCHITECTURES` holds and are
+# filtered at registration, exactly like the SM70/75/80 sets above. They are
+# NOT in GEMM2_KERNELS_SM90, which CMake quarantines to arch 90 because that
+# set really does need wgmma/TMA.
+set(GEMM2_KERNELS_SM120
+    kernel/sm120_16816_4.cu
+)
 set(GEMM2_KERNELS_SM90
     tma.cu
     kernel/sm90_16816_4.cu
@@ -58,6 +66,7 @@ add_library(gemm2
         ${GEMM2_KERNELS_SM70}
         ${GEMM2_KERNELS_SM75}
         ${GEMM2_KERNELS_SM80}
+        ${GEMM2_KERNELS_SM120}
         cublas.cu
         moe_utils_v2.cu
         test/test_utils.cu
diff --git a/src/turbomind/kernels/gemm/arch/config_sm80_s16816.h b/src/turbomind/kernels/gemm/arch/config_sm80_s16816.h
index a449e2cc..9bf4f56f 100644
--- a/src/turbomind/kernels/gemm/arch/config_sm80_s16816.h
+++ b/src/turbomind/kernels/gemm/arch/config_sm80_s16816.h
@@ -105,18 +105,23 @@ struct Sm80_s16816 {
     };
 };
 
+// `A` and `Tc` follow `T` rather than being pinned to `half`.  They were pinned,
+// which made the *dense* w4a16 path fp16-only while the grouped one below was
+// already generic -- so a bf16 model got no dense w4a16 kernel at all and fell
+// back to unquantized cuBLAS.  Every existing instantiation passes `T = half`
+// explicitly (sm70/75/80/90), for which this is a no-op.
 template<class Arch, class T, Order raster_order>  // kColMajor
 using Config_U4_d = Sm80_s16816<Arch,
                                 T,                                      // mma dtype
                                 kColMajor,                              // mma iter order
-                                Operand_A<half, kRowMajor>,             // A
+                                Operand_A<T, kRowMajor>,                // A
                                 Transform_Default,                      // tarnsform A
                                 VoidOperand,                            // U
                                 Operand_B_Pack<uint4_t, kColMajor, 2>,  // B
                                 Transform_HMMA_16816<1, 0>,             // transform B
                                 Operand_UV_Pack<uint32_t, true>,        // V
                                 kRowMajor,                              // order_C
-                                half,                                   // Tc
+                                T,                                      // Tc
                                 raster_order,                           // raster order
                                 -1>;                                    // group axis
 
diff --git a/src/turbomind/kernels/gemm/iterator_sm80.h b/src/turbomind/kernels/gemm/iterator_sm80.h
index a625c68b..fc4db3bc 100644
