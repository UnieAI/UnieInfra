+++ b/src/turbomind/kernels/gemm/iterator_sm80.h
@@ -142,7 +142,7 @@ struct GmemIteratorSm80 {
             src_data_     = reinterpret_cast<const char*>((T*)src_data) + src_offset_;
         }
 
-#if TURBOMIND_ARCH_SM80
+#if TURBOMIND_ARCH_HAS_L2_EVICT_POLICY
         if constexpr (Policy::kEvictPolicy != EvictPolicy::kEvictNormal) {
             asm volatile("createpolicy.fractional.L2::evict_first.b64 %0;\n" : "=l"(cache_policy_) :);
         }
@@ -231,7 +231,9 @@ struct GmemIteratorSm80 {
 
         static constexpr auto cache_op = GetCacheOp<Policy::kCacheOp, size>::value;
 
-        if constexpr (Policy::kEvictPolicy != EvictPolicy::kEvictNormal) {
+        // The `&& TURBOMIND_ARCH_HAS_L2_EVICT_POLICY` drops the hint (not the
+        // copy) on arches that fault on it; see core/common.h.
+        if constexpr (Policy::kEvictPolicy != EvictPolicy::kEvictNormal && TURBOMIND_ARCH_HAS_L2_EVICT_POLICY) {
             CP_ASYNC<cache_op, size, prefetch_size>::apply(ptr, src, cache_policy_, mask);
         }
         else {
diff --git a/src/turbomind/kernels/gemm/kernel/sm120_16816_4.cu b/src/turbomind/kernels/gemm/kernel/sm120_16816_4.cu
new file mode 100644
index 00000000..b31b504e
--- /dev/null
+++ b/src/turbomind/kernels/gemm/kernel/sm120_16816_4.cu
@@ -0,0 +1,225 @@
+// Copyright (c) OpenMMLab. All rights reserved.
+
+// w4a16 for sm_120 (consumer Blackwell, e.g. RTX PRO 6000).
+//
+// Nothing here is a new kernel.  `kernel/sm80_16816_4.cu` is already compiled
+// for sm_120a -- the top-level CMakeLists appends `120a-real` on CUDA >= 12.8,
+// and the `gemm2` target that holds these kernels inherits it.  What stopped
+// them running is a half-open arch range: `Sm80` is `Arch<800, 900>`
+// (gemm/arch.h), so on this device
+//
+//     __CUDA_ARCH__          == 1200
+//     Sm80::is_compatible(1200) == (800 <= 1200 && 1200 < 900) == false
+//
+// which makes `gemm_universal.h`'s `if constexpr (Kernel::Arch::is_compatible(
+// __CUDA_ARCH__))` compile every sm80 kernel body away to an empty __global__,
+// and makes `is_arch_compatible(800, 1200)` reject each one host-side in
+// `Registry::Add`.  The result is that TurboMind registers **zero** w4a16
+// kernels on this card.
+//
+// This is a gate, not a hardware limit.  Every instruction the sm80 U4 path
+// uses exists on sm_120: `mma.sync.aligned.m16n8k16` (core/mma.h),
+// `ldmatrix.sync.aligned.m8n8.x4` (core/smem.h), `cp.async.cg` (gemm/cp_async.h)
+// and the `lop3.b32` u4->f16 unpack (attention/quantization.h).  None of
+// `wgmma`, TMA or `tcgen05` -- which sm_120 lacks -- appear on it; those are
+// confined to the sm90 fp8 path, which CMake already quarantines to arch 90.
+//
+// Shared memory also fits: the widest registered tile here is ~99.8 KB against
+// this card's 101,376 B optin limit, and decode-shaped tiles (CTA_M 16/32/48)
+// sit at 33-51 KB, so >= 2 CTAs stay resident per SM.  `Registry::Add` drops
+// anything over `sharedMemPerBlockOptin` anyway, so a tile that does not fit
+// is skipped rather than fatal.
+//
+// The `Sm120` tag itself already existed in gemm/arch.h; it just had no kernel
+// instantiated against it.  This file is that instantiation.
+
+#include "src/turbomind/kernels/gemm/arch.h"
+#include "src/turbomind/kernels/gemm/arch/config_sm80_s16816.h"
+#include "src/turbomind/kernels/gemm/registry.h"
+#include "src/turbomind/kernels/gemm/types.h"
+#include <type_traits>
+
+namespace turbomind::gemm {
+
+using namespace sm80_s16816;
+using namespace cache_policy;
+using S = cache_policy::Stream;
+using D = cache_policy::Default;
+
+void Registry::sm120_16816_4()
+{
+    auto register_u4_d = [this](auto group_size_tag) {
+        constexpr int kGroupSize = decltype(group_size_tag)::value;
+        // clang-format off
+        using C = Config_U4_d<Sm120, half, kColMajor>;
+        // Add<C::Type<128, 256,  64, 1, 8, 1, D, S, 3, true, 1, kGroupSize>>(); // 0/0
+        Add<C::Type<128, 256,  32, 1, 8, 1, D, D, 3, true, 1, kGroupSize, 128, 128>>(); // 30/3
+        Add<C::Type<128, 256,  32, 1, 8, 1, D, D, 4, true, 1, kGroupSize, 128, 128>>(); // --/20
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize, 64, 128>>();  // --/13
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize, 64, 128>>();  // 21/13
+        Add<C::Type<128, 128,  64, 1, 4, 2, D, S, 3, true, 1, kGroupSize, 64, 128>>();  // 6/6
+
+        Add<C::Type<96, 256,  32, 1, 8, 1, D, D, 4, true, 1, kGroupSize>>();  // --/3
+        Add<C::Type<96, 256,  32, 1, 8, 1, D, S, 3, true, 1, kGroupSize>>();  // 13/13
+        Add<C::Type<96, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();  // 14/10
+        Add<C::Type<96, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();  // 2/2
+
+        Add<C::Type<64, 256,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize, 64, 128>>(); // --/21
+        Add<C::Type<64, 256,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize, 64, 128>>(); // 27/13
+        Add<C::Type<64, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();  // 8/5
+        Add<C::Type<64, 128,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 7/5
+        Add<C::Type<64, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();  // 6/7
+        Add<C::Type<64,  64,  64, 1, 2, 2, D, S, 6, true, 1, kGroupSize>>();
+
+        Add<C::Type<48, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize, 48, 128>>(); // 1/1
+        Add<C::Type<48, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();  // 1/1
+        Add<C::Type<48, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();  // 4/4
+        Add<C::Type<48,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+
+        Add<C::Type<32, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<32, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+
+        Add<C::Type<16, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<16, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<16, 128, 128, 1, 4, 2, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<16,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<16,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+        // clang-format on
+    };
+
+    register_u4_d(std::integral_constant<int, 128>{});
+    register_u4_d(std::integral_constant<int, 32>{});
+
+    auto register_u4_g = [this](auto group_size_tag) {
+        constexpr int kGroupSize = decltype(group_size_tag)::value;
+        // clang-format off
+        using C = Config_U4_g<Sm120, half, kColMajor>;
+        Add<C::Type<128, 256,  32, 2, 4, 1, D, D, 3,   0 , 1, kGroupSize>>();  // 10 + 5 + 4 + 10 + 10, 37
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize>>();  // 1 + 6 + 4 + 4 + 2, 3
+        Add<C::Type< 64, 128,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 7 + 4 + 6 + 2 + 4, 26
+        Add<C::Type< 64, 256,  32, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 18
+        Add<C::Type< 32,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();  // 2
+        Add<C::Type< 32, 128,  64, 1, 4, 1, D, S, 5, true, 1, kGroupSize>>();  // 1 + 2 + 2 + 2 + 2, 2
+        Add<C::Type< 32, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 9
+        Add<C::Type< 16, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 22
+        Add<C::Type< 16, 256,  32, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 8
+        Add<C::Type< 16, 128,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();  // 1 + 13 + 9 + 13 + 7, 7
+        Add<C::Type< 16,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();  // 12 + 2 + 6 + 2 + 8, 42
+        // clang-format on
+    };
+
+    register_u4_g(std::integral_constant<int, 128>{});
+    register_u4_g(std::integral_constant<int, 32>{});
+
+    // bf16 activations.  `Transform_HMMA_16816` already has the bf16 dequant
+    // overload (transform.h) backed by `ConvertKvCache<uint4_t, nv_bfloat16>`
+    // (attention/quantization.h), so bf16 w4a16 needs no new kernel -- only
+    // these instantiations.  `Config_U4_d` had `Operand_A<half>` / `Tc = half`
+    // hardcoded; that is now `T` (config_sm80_s16816.h), a no-op for the
+    // `T = half` instantiations every other arch uses.
+    //
+    // It matters for Qwen3.5-27B, which is bf16: upstream forces fp16 for AWQ
+    // (turbomind/converter.py sets dtype=float16 when model_format=='awq'), and
+    // running fp16 activations under a bf16-trained model is a numerical change
+    // nobody here has priced.  Tile lists are the same as the fp16 sets -- same
+    // instruction family, same smem footprint, and retuning during a port would
+    // confound the port with the tuning.
+    //
+    // `_d` is **dense** and `_g` is **grouped (MoE)**; they are not two spellings
+    // of group-wise quantization.  A linear layer dispatches against
+    // `group_axis = -1` and `ttt_fff` striding, which only the `_d` set answers,
+    // so registering `_g` alone leaves an ordinary bf16 model with no kernel.
+    auto register_u4_d_bf16 = [this](auto group_size_tag) {
+        constexpr int kGroupSize = decltype(group_size_tag)::value;
+        // clang-format off
+        using C = Config_U4_d<Sm120, bfloat16_t, kColMajor>;
+        Add<C::Type<128, 256,  32, 1, 8, 1, D, D, 3, true, 1, kGroupSize, 128, 128>>();
+        Add<C::Type<128, 256,  32, 1, 8, 1, D, D, 4, true, 1, kGroupSize, 128, 128>>();
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize, 64, 128>>();
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize, 64, 128>>();
+        Add<C::Type<128, 128,  64, 1, 4, 2, D, S, 3, true, 1, kGroupSize, 64, 128>>();
+
+        Add<C::Type<96, 256,  32, 1, 8, 1, D, D, 4, true, 1, kGroupSize>>();
+        Add<C::Type<96, 256,  32, 1, 8, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<96, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<96, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+
+        Add<C::Type<64, 256,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize, 64, 128>>();
+        Add<C::Type<64, 256,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize, 64, 128>>();
+        Add<C::Type<64, 128,  32, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<64, 128,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<64, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<64,  64,  64, 1, 2, 2, D, S, 6, true, 1, kGroupSize>>();
+
+        Add<C::Type<48, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize, 48, 128>>();
+        Add<C::Type<48, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<48, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<48,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+
+        Add<C::Type<32, 256,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<32, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<32,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+
+        Add<C::Type<16, 128,  64, 1, 4, 1, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<16, 128, 128, 1, 4, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<16, 128, 128, 1, 4, 2, D, S, 4, true, 1, kGroupSize>>();
+        Add<C::Type<16,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type<16,  64, 128, 1, 2, 2, D, S, 4, true, 1, kGroupSize>>();
+        // clang-format on
+    };
+
+    register_u4_d_bf16(std::integral_constant<int, 128>{});
+    register_u4_d_bf16(std::integral_constant<int, 32>{});
+
+    auto register_u4_g_bf16 = [this](auto group_size_tag) {
+        constexpr int kGroupSize = decltype(group_size_tag)::value;
+        // clang-format off
+        using C = Config_U4_g<Sm120, bfloat16_t, kColMajor>;
+        Add<C::Type<128, 256,  32, 2, 4, 1, D, D, 3,   0 , 1, kGroupSize>>();
+        Add<C::Type<128, 128,  32, 1, 4, 1, D, D, 3, true, 1, kGroupSize>>();
+        Add<C::Type< 64, 128,  64, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type< 64, 256,  32, 1, 4, 1, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type< 32,  64, 128, 1, 2, 2, D, S, 3, true, 1, kGroupSize>>();
+        Add<C::Type< 32, 128,  64, 1, 4, 1, D, S, 5, true, 1, kGroupSize>>();
